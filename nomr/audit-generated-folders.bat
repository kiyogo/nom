@echo off
setlocal
echo Read-only audit: this script does NOT delete anything.
echo Scanning project folders under D:\DATA\source, E:\DATA\source, and E:\htdocs...
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='SilentlyContinue'; $parents=@('D:\DATA\source','E:\DATA\source','E:\htdocs'); $markers=@('Cargo.toml','package.json','pyproject.toml','requirements.txt','setup.py','go.mod','pom.xml','build.gradle','composer.json','CMakeLists.txt'); $projects=[System.Collections.Generic.List[string]]::new(); foreach($parent in $parents){if(-not(Test-Path -LiteralPath $parent)){continue}; foreach($d in Get-ChildItem -LiteralPath $parent -Directory -Force){$isProject=$false; foreach($marker in $markers){if(Test-Path -LiteralPath (Join-Path $d.FullName $marker)){$isProject=$true;break}}; if(-not$isProject){$isProject=[bool](Get-ChildItem -LiteralPath $d.FullName -File -Filter '*.sln'|Select-Object -First 1)}; if(-not$isProject){$isProject=Test-Path -LiteralPath (Join-Path $d.FullName '.git')}; if($isProject){$projects.Add($d.FullName)}}}; $names=@('node_modules','.next','target','dist','build','.venv','venv','bin','obj'); $skip=@('.git','.svn'); $stack=[System.Collections.Generic.Stack[string]]::new(); foreach($project in $projects){$stack.Push($project)}; $found=[System.Collections.Generic.List[string]]::new(); $visited=0; $nextProgress=1000; while($stack.Count -gt 0){$path=$stack.Pop(); $visited++; if($visited -ge $nextProgress){Write-Host ('Scanned '+$visited+' folders...'); $nextProgress+=1000}; foreach($d in Get-ChildItem -LiteralPath $path -Directory -Force){if(($d.Attributes -band [IO.FileAttributes]::ReparsePoint)-ne 0 -or $skip -contains $d.Name){continue}; if($names -contains $d.Name){if($d.Name -in @('bin','obj')){$dotnet=[bool](Get-ChildItem -LiteralPath $path -File -Filter '*.csproj'|Select-Object -First 1) -or [bool](Get-ChildItem -LiteralPath $path -File -Filter '*.sln'|Select-Object -First 1); if(-not$dotnet){continue}}; $found.Add($d.FullName); continue}; $stack.Push($d.FullName)}}; $report=Join-Path $env:TEMP 'project-generated-folders-audit.txt'; $found|Sort-Object -Unique|Set-Content -LiteralPath $report -Encoding UTF8; Write-Host ('Projects scanned: '+$projects.Count); Write-Host ('Candidate folders: '+$found.Count); Write-Host ('Report: '+$report)"
if errorlevel 1 echo Scan failed. Check that PowerShell is available.
echo.
pause
endlocal
